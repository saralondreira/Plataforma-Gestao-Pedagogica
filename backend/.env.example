DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/plataforma_pedagogica"
JWT_SECRET="troca-por-um-segredo-longo-e-aleatorio"
PORT=4000
CORS_ORIGIN="http://localhost:5500"
# Sessão do browser (cookie httpOnly). "lax" serve quando frontend e API estão no mesmo site (ex.: localhost);
# "none" só se estiverem em sites diferentes (exige HTTPS). Em NODE_ENV=production o cookie é sempre Secure.
# COOKIE_SAMESITE="lax"

# Opcional (Fase 8b — envio de credenciais por email ao aprovar um pedido de acesso).
# Sem nada disto definido, o backend usa automaticamente uma conta de teste Ethereal
# (não envia emails reais; mostra um link de pré-visualização na consola do backend).
# Para usar um servidor SMTP real (ex.: Gmail com password de aplicação, ou um serviço
# como Resend/Mailtrap), preenche estas variáveis no teu .env (nunca aqui no .example):
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="conta@exemplo.com"
# SMTP_PASS="a-tua-password-ou-app-password"
# SMTP_FROM="\"Gestão Pedagógica\" <no-reply@exemplo.com>"
