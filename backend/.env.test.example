# Template para a base de dados usada só pelos testes automatizados (`npm test`).
# Copia este ficheiro para ".env.test" e preenche com uma base de dados MySQL
# à parte da de desenvolvimento (os testes fazem deleteMany a tudo antes de cada
# teste — nunca aponta isto para a base de dados real).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/plataforma_pedagogica_test"
JWT_SECRET="troca-por-um-segredo-longo-e-aleatorio-so-para-testes"
